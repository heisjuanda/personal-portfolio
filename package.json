{
  "name": "personal-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-seo-dates.mjs && vite build && vite build --config vite.prerender.config.js && node scripts/prerender.mjs",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "npm run build && wrangler deploy --name personal-portfolio-staging",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.0",
    "@vitejs/plugin-react": "^4.5.2",
    "react-doctor": "^0.9.4",
    "vite": "^8.0.12",
    "vite-plugin-compression2": "^2.5.3",
    "wrangler": "^4.107.0"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.0"
  }
}
